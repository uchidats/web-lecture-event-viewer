rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only verified administrator uchidats@gmail.com can read and write monitor acknowledgements
    match /gemini_monitor_acknowledgements/{document=**} {
      allow read, write: if request.auth != null &&
                            request.auth.token.email == 'uchidats@gmail.com' &&
                            request.auth.token.email_verified == true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
